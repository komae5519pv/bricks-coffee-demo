{
  "name": "daiwt-coffee-shop",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "clean": "rm -rf client/dist dist build node_modules",
    "postinstall": "npm run typegen",
    "prebuild": "npm run sync && npm run typegen -- --wait",
    "predev": "npm run sync && npm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "render:appyaml": "node tools/render_app_yaml.mjs",
    "setup": "appkit setup --write"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "DAIWT Tokyo keynote coffee shop - 2026 rebuild with Lakebase + on-app agent",
  "dependencies": {
    "@databricks/appkit": "0.57.0",
    "@databricks/appkit-ui": "0.57.0",
    "@databricks/sdk-experimental": "0.17.0",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "0.546.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "file:vendor/react-markdown-10.1.0.tgz",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.18.0",
    "remark-gfm": "file:vendor/remark-gfm-4.0.1.tgz",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "prettier": "3.6.2",
    "tailwindcss": "4.0.14",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.1.9",
    "yaml": "file:vendor/yaml-2.9.0.tgz"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "@opentelemetry/core": "2.8.0",
    "systeminformation": "5.31.7",
    "yaml": "file:vendor/yaml-2.9.0.tgz",
    "markdown-table": "file:vendor/markdown-table-3.0.4.tgz",
    "mdast-util-gfm": "file:vendor/mdast-util-gfm-3.1.0.tgz",
    "mdast-util-gfm-autolink-literal": "file:vendor/mdast-util-gfm-autolink-literal-2.0.1.tgz",
    "mdast-util-gfm-footnote": "file:vendor/mdast-util-gfm-footnote-2.1.0.tgz",
    "mdast-util-gfm-strikethrough": "file:vendor/mdast-util-gfm-strikethrough-2.0.0.tgz",
    "mdast-util-gfm-table": "file:vendor/mdast-util-gfm-table-2.0.0.tgz",
    "mdast-util-gfm-task-list-item": "file:vendor/mdast-util-gfm-task-list-item-2.0.0.tgz",
    "micromark-extension-gfm": "file:vendor/micromark-extension-gfm-3.0.0.tgz",
    "micromark-extension-gfm-autolink-literal": "file:vendor/micromark-extension-gfm-autolink-literal-2.1.0.tgz",
    "micromark-extension-gfm-footnote": "file:vendor/micromark-extension-gfm-footnote-2.1.0.tgz",
    "micromark-extension-gfm-strikethrough": "file:vendor/micromark-extension-gfm-strikethrough-2.1.0.tgz",
    "micromark-extension-gfm-table": "file:vendor/micromark-extension-gfm-table-2.1.2.tgz",
    "micromark-extension-gfm-tagfilter": "file:vendor/micromark-extension-gfm-tagfilter-2.0.0.tgz",
    "micromark-extension-gfm-task-list-item": "file:vendor/micromark-extension-gfm-task-list-item-2.1.0.tgz",
    "remark-gfm": "file:vendor/remark-gfm-4.0.1.tgz",
    "remark-stringify": "file:vendor/remark-stringify-11.0.0.tgz",
    "escape-string-regexp@^5.0.0": "file:vendor/mdast-util-find-and-replace--escape-string-regexp-5.0.0.tgz",
    "mdast-util-find-and-replace": "file:vendor/mdast-util-find-and-replace-3.0.2.tgz"
  }
}

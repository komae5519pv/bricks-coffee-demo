#BARISTA_MODEL=databricks-kimi-k3
PGDATABASE=databricks_postgres
LAKEBASE_ENDPOINT=projects/konomi-coffee-shop/branches/production/endpoints/primary
PGHOST=ep-delicate-star-d2zzsnde-pooler.database.us-east-1.cloud.databricks.com
PGPORT=5432
PGSSLMODE=require
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=daiwt-coffee-shop
FLASK_RUN_HOST=localhost
EMBEDDING_ENDPOINT_NAME=databricks-qwen3-embedding-0-6b
# MLflow トレーシング (バリスタエージェント)。認証は DATABRICKS_CONFIG_PROFILE
# (ローカル) または Apps 注入の SP 環境変数 (デプロイ時) に委譲。シークレット不要。
#MLFLOW_EXPERIMENT_NAME=/Shared/daiwt-coffee-shop-barista
#MLFLOW_TRACING_ENABLED=true
#MLFLOW_TRACKING_URI=databricks://fevm-konomi-demo   # 省略時は PROFILE から自動導出

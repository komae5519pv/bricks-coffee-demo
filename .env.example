# ローカル開発用 .env の雛形。コピーして自分の環境の値に置き換える:
#   cp .env.example .env
# 各値の調べ方は README「ローカル開発用 .env の作り方」を参照。

# 自分の Databricks CLI プロファイル (databricks auth profiles で確認)
DATABRICKS_CONFIG_PROFILE=<your-cli-profile>
DATABRICKS_SERVING_ENDPOINT_NAME=<your-agent-llm-endpoint>
# バリスタエージェントの LLM (省略時は databricks-kimi-k3)
#BARISTA_MODEL=databricks-kimi-k3
PGDATABASE=databricks_postgres
LAKEBASE_ENDPOINT=projects/<your-lakebase-project-id>/branches/production/endpoints/primary
# Lakebase エンドポイントのホスト名 (README の手順で取得)
PGHOST=<your-lakebase-endpoint-host>
PGPORT=5432
PGSSLMODE=require
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=<your-app-name>
FLASK_RUN_HOST=localhost
EMBEDDING_ENDPOINT_NAME=<your-embedding-endpoint>
# ローカル起動時のデモシード (本番は databricks.yml の variables から app.yaml に注入)
#SEED_STAFF_EMAIL=<you@example.com>
#SEED_DEMO_PREFERENCES=true
# MLflow トレーシング (バリスタエージェント)。認証は DATABRICKS_CONFIG_PROFILE
# (ローカル) または Apps 注入の SP 環境変数 (デプロイ時) に委譲。シークレット不要。
#MLFLOW_EXPERIMENT_NAME=/Shared/daiwt-coffee-shop-barista
#MLFLOW_TRACING_ENABLED=true
#MLFLOW_TRACKING_URI=databricks://<your-cli-profile>   # 省略時は PROFILE から自動導出
# 評価ハーネス (npm run eval)。詳細は README「MLflow トレーシング & 評価」
#BARISTA_EVAL_BASE_URL=http://localhost:8000
#BARISTA_EVAL_JUDGE_MODEL=databricks:/databricks-meta-llama-3-3-70b-instruct
